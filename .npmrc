# .npmrc — Tracked workspace package manager configuration
# Registry and authentication settings for pnpm.
# Dependency resolution rules (like strict-peer-dependencies) are managed
# in pnpm-workspace.yaml for the workspace.

# Pin to the public npm registry by default.
registry=https://registry.npmjs.org/

# Use environment variables for tokens; never commit real secrets.
# Example for a private registry:
# //registry.npmjs.org/:_authToken=${NPM_TOKEN}

# Ensure pnpm uses the workspace protocol for local packages.
link-workspace-packages=true