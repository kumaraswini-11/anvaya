{
  "name": "anvaya",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "ANVAYA School Management ERP monorepo",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=26.0.0 <27",
    "pnpm": ">=12.21.0"
  },
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "node scripts/dev-preflight.mjs && turbo run dev --continue",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "seed": "pnpm --filter=@anvaya/api run seed:demo",
    "clean": "turbo run clean && node scripts/clean.mjs",
    "format": "biome format . --write",
    "format:check": "biome format .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts,json,jsonc,json5,yaml,yml,toml,css,scss,md,mdx,html,vue}": "biome check --write --no-errors-on-unmatched"
  }
}
